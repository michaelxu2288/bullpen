modules = ["go-1.21", "nodejs-20"]
run = "go run . server --chaos"
entrypoint = "main.go"

[deployment]
build = ["sh", "-c", "CGO_ENABLED=0 go build -trimpath -ldflags=-s -o bullpen ."]
run = ["sh", "-c", "exec ./bullpen server --chaos"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80
